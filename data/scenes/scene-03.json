  "blocks": [
    {
      "type": "heading",
      "text": "CHOSEN: THE STORY BEFORE THE MANGER",
      "namedStyleType": "HEADING_1"
    },
    {
      "type": "heading",
      "text": "SCENE 3 — Mary (Jordyn), Talia (Tasha), Shira(Tyfany), Adina(Jeovanie), Dafna(Ashley)",
      "namedStyleType": "HEADING_1"
    },
    {
      "type": "production-note",
      "text": "Approximate Running Time: 5–6 minutes",
      "namedStyleType": "SUBTITLE"
    },
    {
      "type": "production-note",
      "text": "Spoken Dialogue: Approximately 2½–3 minutes",
      "namedStyleType": "SUBTITLE"
    },
    {
      "type": "production-note",
      "text": "Song: “Chosen” — approximately 2½–3 minutes",
      "namedStyleType": "SUBTITLE"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "transition",
      "text": "CONTINUOUS FROM SCENE 2",
      "namedStyleType": "HEADING_5"
    },
    {
      "type": "stage",
      "text": "Joseph has just exited.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "JOSEPH",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Tomorrow?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Tomorrow.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Joseph disappears.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary remains alone.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "For several seconds, nothing happens.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Let the audience stay with her happiness.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary looks toward the place Joseph exited.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She smiles.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She begins quietly putting things in order.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Perhaps she",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "folds a piece of cloth;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "straightens the unfinished table piece Joseph showed her;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "moves one of the chairs;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "touches the wood and imagines the future they were just discussing.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She catches herself smiling.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Eight chairs.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "She shakes her head.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Joseph...",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Small laugh.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She resumes folding.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "THE INTERRUPTION",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "The distant sounds of Nazareth are still present.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "A voice.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "A cart.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "A child somewhere outside.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "A faint hammer.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Then—",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "everything stops.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not slowly.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Gone.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary notices.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She waits.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Hello?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Nothing.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She listens.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Is someone there?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "A subtle musical texture enters.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Something completely different from the musical language of Nazareth.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not loud.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not threatening.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Unfamiliar.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The light begins changing.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary turns.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She sees GABRIEL.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Gabriel does not rush toward her.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Stillness is part of the power of the moment.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Mary.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary steps backward.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Who are you?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Do not be afraid.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I wasn't—",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "She stops.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I… ok, wait…",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary stops and backs away",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Gabriel remains calm.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You have found favor with God.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Gabriel walks towards Mary",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Favor?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "Still walks away from Gabriel slowly",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Yes.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "Continues walking towards Mary",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I don't understand.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "Still walks backwards away from Gabriel",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You will.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "Continues walking towards Mary",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Who are you?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "Still walks backwards away from Gabriel",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Gabriel.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "A beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Stops walking and stands still",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I have been sent by God.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary stops, she absorbs that.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She looks toward the doorway, as though part of her still expects someone else to walk in and make this ordinary again.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "No one does.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "THE CALLING",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Mary...",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "you have been chosen.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary looks at him.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Chosen for what?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You will bear a son.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Silence.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary does not respond.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I'm sorry—",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "what did you say?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You will bear a son.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "No.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Not rejection.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Her mind simply cannot make the words fit.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I mean—",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "how?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "How can that be?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "What will happen comes from God.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I understand the words.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I don't understand how they can be true.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Nothing God has spoken is beyond His power.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary looks at him carefully.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Why me?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Because God has chosen you.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "That doesn't answer the question.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Gabriel regards her.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not offended.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "It may be the only answer you are given tonight.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "That lands.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "MARY SEARCHES FOR CERTAINTY",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You expect me to believe this?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I expect you to decide whether you will trust the One who sent me.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Those aren't the same thing.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "No.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "They are not.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary studies him.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "That answer surprises her.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "What happens now?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You live the answer.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "That's all?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "No.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Your relative Elizabeth is also expecting a child.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary looks up.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Elizabeth?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Yes.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "But she—",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary stops herself.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She knows what she was going to say.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "What seemed impossible...",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "is already happening.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary takes that in.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "This is the first piece of the message she can attach to something in her world.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Elizabeth.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Go to her if you need to see what God has already begun.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "THE COST ARRIVES",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "Mary looks toward the unfinished table.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The future from Scene 2 is sitting in front of her.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The house.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The table.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The marriage.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Joseph.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Her breathing changes slightly.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "What will people think?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Gabriel does not answer immediately.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "My family?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "The village?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Still no false reassurance.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Joseph...",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "That name lands hardest.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "What am I supposed to tell Joseph?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "The truth.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "And if the truth sounds impossible?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "It will still be the truth.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "That doesn't mean he'll believe me.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "No.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary looks at Gabriel.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "That is not the answer she wanted.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "You don't know Joseph.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "God does.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "He has plans.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Her eyes move back to the table.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "We have plans.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "A home.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "A wedding.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "A family.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "He thinks he knows how our life is supposed to go.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "And you?",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary looks at him.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Until a moment ago...",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "dialogue",
      "text": "so did I.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "music",
      "text": "MUSICAL TRIGGER — “CHOSEN”",
      "namedStyleType": "HEADING_4"
    },
    {
      "type": "stage",
      "text": "The first musical phrase begins.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not triumph.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not celebration.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "A question.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Gabriel does not suddenly disappear.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "He remains present, but the focus begins transferring to Mary.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "music",
      "text": "The song begins because she has finally understood",
      "namedStyleType": "HEADING_4"
    },
    {
      "type": "stage",
      "text": "This miracle has a cost.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "“CHOSEN”",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "heading",
      "text": "SONG JOURNEY",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "heading",
      "text": "SECTION 1 — WHY ME?",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "Mary confronts the word chosen.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She is not royalty.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not powerful.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not extraordinary by the world's standards.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Why would God place something this enormous in the hands of someone from Nazareth?",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The lyrical thought should be",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "lyric",
      "text": "Why would being chosen feel this frightening?",
      "namedStyleType": "TITLE"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "SECTION 2 — WHAT WILL THIS COST?",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "Mary sees everything from Scene 2 in a new light",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Joseph;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "their wedding;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "the house;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "the table;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "her family;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "her name;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "what Nazareth will say;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "whether Joseph will stay.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Fragments of the musical language of “My Beloved” may briefly appear underneath “Chosen.”",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not a full reprise.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Just enough for the audience to feel the future that is now endangered.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "SECTION 3 — I CANNOT SEE THE ROAD",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "Mary begins understanding that Gabriel is not going to give her the entire future.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She does not know",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "what Joseph will do;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "how people will react;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "where this road ends;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "what obedience will cost.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The central realization",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "lyric",
      "text": "I do not have to see the whole road to take the next step.",
      "namedStyleType": "TITLE"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "SECTION 4 — CHOSEN BECOMES A CHOICE",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "The word changes meaning.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "At the beginning of the song",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "lyric",
      "text": "God chose me.",
      "namedStyleType": "TITLE"
    },
    {
      "type": "stage",
      "text": "By the end",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "lyric",
      "text": "Will I choose to trust God?",
      "namedStyleType": "TITLE"
    },
    {
      "type": "music",
      "text": "Possible central lyrical territory",
      "namedStyleType": "HEADING_4"
    },
    {
      "type": "lyric",
      "text": "Chosen doesn't mean unafraid.",
      "namedStyleType": "TITLE"
    },
    {
      "type": "stage",
      "text": "and/or",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "lyric",
      "text": "If You chose me, give me courage to choose You.",
      "namedStyleType": "TITLE"
    },
    {
      "type": "stage",
      "text": "The music grows emotionally—",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "but avoid turning it into a giant power-ballad finish.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "This should feel like Mary becoming steady, not invincible.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "music",
      "text": "THE MUSIC APPROACHES ITS FINAL RESOLUTION",
      "namedStyleType": "HEADING_4"
    },
    {
      "type": "stage",
      "text": "Mary turns toward Gabriel.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The music holds.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Then—",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "nearly stops.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Silence.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary breathes.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She is still afraid.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "That matters.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I don't understand what comes next.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I know.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "And I'm afraid.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I know.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "But if God has asked this of me...",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "She gathers herself.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I am the Lord's servant.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Beat.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Let it be with me as He has said.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Silence.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "No instant explosion of music.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "No triumphant celebration.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Let the decision stand by itself.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Gabriel regards her.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "For the first time, there may be something almost tender in his expression.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "Do not be afraid, Mary.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "stage",
      "text": "Mary takes a breath.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "character",
      "text": "MARY",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "I'm trying.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "character",
      "text": "GABRIEL",
      "namedStyleType": "HEADING_3"
    },
    {
      "type": "dialogue",
      "text": "That is enough for tonight.",
      "namedStyleType": "NORMAL_TEXT"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "heading",
      "text": "GABRIEL DEPARTS",
      "namedStyleType": "HEADING_2"
    },
    {
      "type": "stage",
      "text": "The light around Gabriel begins to change.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Do not make his departure a magic trick simply for spectacle.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "It can be",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "a controlled fade;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "a shift in light;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Gabriel moving into darkness;",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary's attention being pulled briefly elsewhere and finding him gone.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "The divine musical texture recedes.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary is alone again.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Same room.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Same wood.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Same cloth.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Same unfinished table.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Nothing looks different.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Everything is different.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "spacer",
      "text": ""
    },
    {
      "type": "transition",
      "text": "FINAL MOMENT",
      "namedStyleType": "HEADING_5"
    },
    {
      "type": "stage",
      "text": "Mary stands quietly.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "She touches the unfinished table.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "A faint fragment of “My Beloved” is heard.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Perhaps only a few notes.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Mary remembers",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "lyric",
      "text": "“Whatever comes, I'll walk with you.”",
      "namedStyleType": "TITLE"
    },
    {
      "type": "stage",
      "text": "Her expression changes.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Not because she regrets saying yes.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
      "text": "Because now she understands what she has to do next.",
      "namedStyleType": "HEADING_6"
    },
    {
      "type": "stage",
